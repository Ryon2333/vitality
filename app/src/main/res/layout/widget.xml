<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_bg">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="V I T A L I T Y" android:textSize="11sp" android:textStyle="bold" android:textColor="#486ED1" />
    <TextView android:id="@+id/widget_value" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:text="100" android:textSize="45sp" android:textStyle="bold" android:textColor="#1E3152" />
    <TextView android:id="@+id/widget_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:text="Ready to create." android:textSize="11sp" android:textColor="#5E759B" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_minus" android:layout_width="0dp" android:layout_weight="1" android:layout_height="42dp" android:gravity="center" android:text="−5" android:textSize="16sp" android:textColor="#4267C5" />
        <TextView android:id="@+id/widget_plus" android:layout_width="0dp" android:layout_weight="1" android:layout_height="42dp" android:gravity="center" android:text="＋5" android:textSize="16sp" android:textColor="#4267C5" />
    </LinearLayout>
</LinearLayout>
